---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Hamsa – Powering the Finternet', description = 'Hamsa builds the Unified Ledger: faster, safer, lower-cost clearing and settlement for central banks and financial institutions.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
