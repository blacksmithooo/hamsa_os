---
import { asset } from '../lib/asset';
// Figma: "Global Nav Header" (181:3004) — 1440×65, translucent white with background blur.
// Menu: "Hamburger Menu R3 1–11" (181:5237, 183:822 …). The eleven frames are one menu with a
// different link hovered in each: the hovered link slides right 30px and gets its number, and
// the background steps from #d2506a to #313150.
const columns = [
  {
    label: 'Infrastructure',
    items: ['Platform', 'Canonical Primitives and Verified Financial Services', 'Cloud-Native<br />Subledgers', 'Koru', 'AI Coordination'],
  },
  {
    label: 'Applications',
    items: ['Overview', 'Subaccounting', 'Digital Transfer<br />Agency', 'Settlement<br />and Tokenization'],
  },
  { label: 'Resources', items: ['About us', 'Security, Regulatory and Disclosure'] },
];
const shades = ['#d2506a', '#c24d67', '#b24a65', '#a24762', '#924460', '#82415d', '#713d5a', '#613a58', '#513755', '#413453', '#313150'];
let n = 0;
const numbered = columns.map((c) => ({ ...c, items: c.items.map((html) => ({ html, i: n++ })) }));
const clocks = [
  ['America/New_York', 'NYC'],
  ['America/Los_Angeles', 'San Francisco'],
  ['Asia/Singapore', 'Singapore'],
  ['America/Sao_Paulo', 'São Paulo'],
  ['Europe/Zurich', 'Europe'],
];
---
<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="site-header__logo" href={asset('')} aria-label="Hamsa home">
      <img src={asset('images/hamsa-logo.svg')} alt="Hamsa" width="143" height="62" />
    </a>
    <button class="site-header__menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu" data-menu-open>
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="menu" id="site-menu" hidden data-menu data-lenis-prevent data-first-shade={shades[0]} style={`--menu-bg: ${shades[0]}`}>
  <div class="menu__bar"><div class="menu__frame">
    <a class="menu__logo" href={asset('')} aria-label="Hamsa home">
      <img src={asset('images/icons/hamsa-logo-white.svg')} alt="Hamsa" width="143" height="62" />
    </a>
    <button class="menu__close" type="button" aria-label="Close menu" data-menu-close></button>
  </div></div>
  <div class="menu__frame menu__body">
  <p class="menu__tagline" data-stagger>Powering<br />the Finternet</p>
  <ul class="menu__clocks" data-stagger>
    {clocks.map(([tz, city]) => (
      <li><span data-tz={tz}>--:--</span>&nbsp;&nbsp;({city})</li>
    ))}
  </ul>
  <nav class="menu__nav" aria-label="Main">
    {numbered.map((col) => (
      <div class={`menu__col menu__col--${col.label.toLowerCase()}`}>
        <p class="menu__label" data-stagger>{col.label}</p>
        <ul>
          {col.items.map((item) => (
            <li data-stagger>
              <a href="#" style={`--shade: ${shades[item.i]}`}>
                <span class="menu__num">{String(item.i + 1).padStart(2, '0')}</span>
                <span set:html={item.html} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
  </div>
</div>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]')!;

  // Open: diagonal colour swipe from the menu button's corner (--dur-2), then the items drop in
  // one by one (--stagger apart). Close: the swipe runs back on the exit curve, at 75% of the time.
  const staggered = [...menu.querySelectorAll<HTMLElement>('[data-stagger]')];
  staggered.forEach((el, i) => el.style.setProperty('--d', `calc(var(--dur-2) * 0.4 + var(--stagger) * ${i})`));
  let closeTimer = 0;

  const setOpen = (open: boolean) => {
    clearTimeout(closeTimer);
    openBtn.setAttribute('aria-expanded', String(open));
    const root = document.documentElement;
    if (open) {
      // Measure the scrollbar before anything hides it, then pad by that width so nothing shifts.
      root.style.setProperty('--sbw', `${innerWidth - root.clientWidth}px`);
      root.classList.add('menu-open');
      window.lenis?.stop(); // pause smooth scrolling so the wheel doesn't move the page behind the menu
      menu.classList.remove('is-open', 'is-closing');
      menu.hidden = false;
      void menu.offsetWidth; // start the transition from the closed state
      menu.classList.add('is-open');
      closeBtn.focus({ preventScroll: true });
    } else {
      menu.classList.remove('is-open');
      menu.classList.add('is-closing');
      closeTimer = window.setTimeout(() => {
        menu.hidden = true;
        menu.classList.remove('is-closing');
        menu.style.setProperty('--menu-bg', menu.dataset.firstShade!);
        menu.scrollTop = 0;
        links.forEach((a) => a.classList.remove('is-active'));
        root.classList.remove('menu-open');
        window.lenis?.start(); // only once the menu has fully closed, together with the scrollbar returning
      }, 300); // = --dur-2 × 0.75, the exit swipe
      openBtn.focus({ preventScroll: true });
    }
  };
  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) setOpen(false);
  });

  // Background follows the hovered / focused link.
  const links = [...menu.querySelectorAll<HTMLAnchorElement>('.menu__nav a')];
  links.forEach((a) => {
    const set = () => menu.style.setProperty('--menu-bg', a.style.getPropertyValue('--shade'));
    a.addEventListener('mouseenter', set);
    a.addEventListener('focus', set);
  });

  // Touch screens can't hover, so there the menu's scroll position picks the link instead: scrolling
  // from top to bottom steps through the links (and their shades) in order.
  const touch = matchMedia('(hover: none)');
  menu.addEventListener('scroll', () => {
    if (!touch.matches) return;
    const range = menu.scrollHeight - menu.clientHeight;
    if (range <= 0) return;
    const i = Math.round((menu.scrollTop / range) * (links.length - 1));
    links.forEach((a, j) => a.classList.toggle('is-active', j === i));
    menu.style.setProperty('--menu-bg', links[i].style.getPropertyValue('--shade'));
  }, { passive: true });

  // Fold the nav away while the footer (which repeats the logo and links) is on screen.
  const header = document.querySelector<HTMLElement>('[data-site-header]')!;
  const footerNav = document.querySelector('[data-hides-nav]');
  if (footerNav) {
    new IntersectionObserver(([entry]) => header.classList.toggle('is-folded', entry.isIntersecting)).observe(footerNav);
  }

  // Live city clocks, formatted like the design: "09:17am".
  const tick = () => {
    menu.querySelectorAll<HTMLElement>('[data-tz]').forEach((el) => {
      const parts = new Intl.DateTimeFormat('en-US', { timeZone: el.dataset.tz, hour: '2-digit', minute: '2-digit', hour12: true }).formatToParts(new Date());
      const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
      el.textContent = `${get('hour')}:${get('minute')}${get('dayPeriod').toLowerCase()}`;
    });
  };
  tick();
  setInterval(tick, 30_000);
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    height: 65px;
    background: rgb(255 255 255 / 0.05);
    backdrop-filter: blur(7.5px); /* Figma background blur 15 */
    border-bottom: 1px solid rgb(255 255 255 / 0.25);
    transition: transform var(--dur-2) var(--ease-hamsa-exit);
  }
  /* Folded away over the footer; comes back if someone tabs to it. */
  .site-header.is-folded:not(:focus-within) { transform: translateY(-100%); }
  /* Folding away is an exit (mirror curve); coming back is an entrance. */
  .site-header:not(.is-folded) { transition-timing-function: var(--ease-hamsa); }
  :global(html.menu-open) .site-header,
  :global(html.menu-open) .menu { padding-right: var(--sbw, 0px); }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }
  .site-header__inner {
    position: relative;
    max-width: var(--frame);
    height: 100%;
    margin: 0 auto;
  }
  .site-header__logo,
  .menu__logo {
    position: absolute;
    left: 48px;
    top: 2px;
  }
  .site-header__logo img,
  .menu__logo img { width: 142.3px; height: auto; }
  .site-header__menu {
    position: absolute;
    right: 64px;
    top: 18px;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  /* Two 2px black lines, 14px apart (Figma y=26 and y=40). */
  .site-header__menu span {
    position: absolute;
    left: 0;
    width: 30px;
    height: 2px;
    background: #000;
  }
  .site-header__menu span:first-child { top: 7px; }
  .site-header__menu span:last-child { top: 21px; }

  /* ---------- Menu overlay ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 20;
    overflow-y: auto;
    overscroll-behavior: contain; /* don't hand the scroll on to the page behind */
    background: var(--menu-bg);
    color: #fff;
    transition: background-color var(--dur-2) var(--ease-hamsa);
  }
  .menu[hidden] { display: none; }

  /* Diagonal swipe: a triangle anchored at the top-right corner whose long edge sweeps across. */
  .menu {
    clip-path: polygon(100% 0, 100% 0, 100% 0);
    transition: background-color var(--dur-2) var(--ease-hamsa), clip-path calc(var(--dur-2) * 0.75) var(--ease-hamsa-exit);
  }
  .menu.is-open {
    clip-path: polygon(100% 0, -130% 0, 100% 230%);
    transition: background-color var(--dur-2) var(--ease-hamsa), clip-path var(--dur-2) var(--ease-hamsa);
  }
  .menu [data-stagger] {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity calc(var(--dur-1) * 0.75) var(--ease-hamsa-exit), transform calc(var(--dur-1) * 0.75) var(--ease-hamsa-exit);
  }
  .menu.is-open [data-stagger] {
    opacity: 1;
    transform: none;
    transition: opacity var(--dur-2) var(--ease-hamsa) var(--d), transform var(--dur-2) var(--ease-hamsa) var(--d);
  }
  @media (prefers-reduced-motion: reduce) {
    .menu, .menu.is-open { clip-path: none; transition: background-color var(--dur-2) var(--ease-hamsa); }
    .menu [data-stagger], .menu.is-open [data-stagger] { opacity: 1; transform: none; transition: none; }
    .menu__close::before, .menu__close::after { transition: none !important; }
  }
  .menu__bar {
    height: 65px;
    border-bottom: 1px solid rgb(255 255 255 / 0.25);
  }
  /* Run the hairline under the scrollbar gap too, without moving the logo or the X. */
  :global(html.menu-open) .menu__bar {
    margin-right: calc(-1 * var(--sbw, 0px));
    padding-right: var(--sbw, 0px);
  }
  /* Same centred 1440px column as the homepage, so the menu lines up on any screen width. */
  .menu__frame {
    position: relative;
    max-width: var(--frame);
    height: 100%;
    margin: 0 auto;
  }
  .menu__body { height: auto; min-height: 745px; } /* 810 − 65 bar */
  /* Close button: same box and two lines as the hamburger, so opening reads as the hamburger
     morphing into an X — the lines slide together, then rotate. Closing plays it in reverse. */
  .menu__close {
    position: absolute;
    right: 64px;
    top: 18px;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .menu__close::before,
  .menu__close::after {
    content: '';
    position: absolute;
    left: 0;
    width: 30px;
    height: 2px;
    background: #fff;
    transition: top calc(var(--dur-1) * 0.75) var(--ease-hamsa-exit) calc(var(--dur-1) * 0.6), transform calc(var(--dur-1) * 0.75) var(--ease-hamsa-exit);
  }
  .menu__close::before { top: 7px; }
  .menu__close::after { top: 21px; }
  .menu.is-open .menu__close::before,
  .menu.is-open .menu__close::after {
    top: 14px;
    transition: top var(--dur-1) var(--ease-hamsa) calc(var(--stagger) * 2), transform var(--dur-2) var(--ease-hamsa) calc(var(--stagger) * 6);
  }
  .menu.is-open .menu__close::before { transform: rotate(45deg); }
  .menu.is-open .menu__close::after { transform: rotate(-45deg); }
  .menu__close:focus-visible { outline: 2px solid #fff; outline-offset: 6px; border-radius: 4px; }
  .menu__tagline {
    position: absolute;
    left: 64px;
    top: 97px; /* Figma y=162 */
    font-size: 32px;
    font-weight: 400;
    line-height: 32px;
  }
  .menu__clocks {
    position: absolute;
    left: 64px;
    top: 587px; /* Figma y=652: bottom-aligned in a 612–725 box */
    font-size: 11px;
    font-weight: 600;
    line-height: 14.6px;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .menu__nav {
    position: absolute;
    left: 35.35%; /* Figma x=509 of 1440 */
    right: 4.86%; /* ends at x=1370 */
    top: 97px; /* Figma y=162 */
    display: grid;
    grid-template-columns: 446fr 415fr; /* 446px + 415px at 1440 */
    grid-template-rows: auto auto;
    column-gap: 0;
  }
  .menu__col--infrastructure { grid-row: 1 / span 2; }
  .menu__col--resources { margin-top: 81px; }
  .menu__label {
    height: 24px;
    font-size: 11px;
    font-weight: 500;
    line-height: 10.45px;
    letter-spacing: 2.2px;
    text-transform: uppercase;
  }
  .menu__col ul { display: grid; gap: 9px; }
  .menu__col a {
    position: relative;
    display: block;
    font-size: 46px;
    font-weight: 500;
    line-height: 41.4px;
    letter-spacing: -0.46px;
    transition: transform var(--dur-1) var(--ease-hamsa);
  }
  .menu__num {
    position: absolute;
    left: 0;
    top: 6px;
    font-size: 14px;
    font-weight: 600;
    line-height: 14px;
    opacity: 0;
    transition: opacity var(--dur-1) var(--ease-hamsa);
  }
  .menu__col a > span:last-child { display: block; transition: transform var(--dur-1) var(--ease-hamsa); }
  .menu__col a:hover > span:last-child,
  .menu__col a:focus-visible > span:last-child,
  .menu__col a.is-active > span:last-child { transform: translateX(30px); }
  .menu__col a:hover .menu__num,
  .menu__col a:focus-visible .menu__num,
  .menu__col a.is-active .menu__num { opacity: 1; }
  .menu__col a:focus-visible { outline: none; }

  @media (max-width: 1100px) {
    .site-header__logo, .menu__logo { left: 8px; }
    .site-header__menu { right: 16px; }
    .menu__close { right: 16px; }
    .menu__tagline, .menu__clocks, .menu__nav { position: static; }
    .menu__body { min-height: 0; display: flex; flex-direction: column; }
    .menu__tagline { order: 1; } /* tagline and clocks sit under the links */
    .menu__clocks { order: 2; }
    .menu__tagline { padding: 16px 24px 24px; }
    .menu__nav { display: grid; grid-template-columns: 1fr; gap: 32px; padding: 32px 24px; }
    .menu__col--infrastructure { grid-row: auto; }
    .menu__col--resources { margin-top: 0; }
    .menu__col a { font-size: 32px; line-height: 30px; }
    .menu__clocks { padding: 8px 24px 48px; }
  }

  /* Older Safari (15–17) only understands the prefixed property. */
  @supports not (backdrop-filter: none) {
    .site-header { -webkit-backdrop-filter: blur(7.5px); }
  }
</style>
