---
import { asset } from '../lib/asset';
// Figma: "Module 1" (181:2667). Five frames of one scroll-driven sequence, 1440×810 each:
//   1a  full-bleed starling murmuration, "Don't sacrifice privacy."       (181:2721)
//   1a' same image, "Operate as one."                                     (195:4460)
//   1b  image shrinks (passed through, not held) to a 1090×580 card (radius 100) on the embossed bg   (181:2692)
//   1c  card becomes a 637×176 ring (30px image stroke), "Request a demo"   (181:2680)
//   1d  ring becomes a 579×120 black 2px outline pill; scrim fades to white (181:2668)
// The section pins while you scroll. Scroll swaps the two phrases; past a set point, 1b → 1d plays as one
// timed animation (not scrubbed), and scrolling back above that point plays it in reverse.
---
<section class="flock" data-flock aria-label="Don't sacrifice privacy. Operate as one.">
  <div class="flock__stage">
    <div class="flock__bg" aria-hidden="true"></div>
    <div class="flock__media" data-media aria-hidden="true">
      <div class="flock__hole" data-hole></div>
    </div>
    <p class="flock__line" data-line="0">Don't sacrifice privacy.</p>
    <p class="flock__line" data-line="1">Operate as one.</p>
    <a class="flock__cta" href="#contact" data-cta aria-label="Request a demo"><span class="flock__words" aria-hidden="true">{['Request', 'a', 'demo'].map((w, i) => <span class="flock__word"><span style={`--i: ${i}`}>{w}</span></span>)}</span></a>
    <div class="flock__scrim" data-scrim aria-hidden="true"></div>
  </div>
</section>

<script>
  import { hamsaEase } from '../lib/motion';
  type Box = { w: number; h: number; r: number; ring: number };
  // Keyframes in Figma pixels, centred on the stage. `w: 0` means "full stage".
  const FULL: Box = { w: 0, h: 0, r: 0, ring: 0 };
  const RING: Box = { w: 637, h: 176, r: 100, ring: 30 };
  const FLOCK_AR = 1440 / 746; // flock.webp
  const RING_AR = 1280 / 720; // flock-ring.webp
  const IMG_END = 0.7; // photo scale when the box reaches the pill
  const EMBOSS_AR = 1440 / 810; // emboss-bg.webp
  const PILL: Box = { w: 579, h: 120, r: 100, ring: 0 };

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const seg = (p: number, a: number, b: number) => hamsaEase(clamp((p - a) / (b - a)));

  document.querySelectorAll<HTMLElement>('[data-flock]').forEach((root) => {
    const media = root.querySelector<HTMLElement>('[data-media]')!;
    const hole = root.querySelector<HTMLElement>('[data-hole]')!;
    const lines = root.querySelectorAll<HTMLElement>('[data-line]');
    const cta = root.querySelector<HTMLElement>('[data-cta]')!;
    const words = cta.querySelector<HTMLElement>('.flock__words')!;
    const scrim = root.querySelector<HTMLElement>('[data-scrim]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1b → 1d is one continuous motion: a single Murmuration ease over --dur-4 carries the photo from full
    // bleed to the pill (passing through the card and ring shapes, never stopping on them). The ring, the hole
    // and the outline blend in over windows of that one eased progress, so nothing starts or stops on its own.
    const T_END = 1200; // --dur-4
    const TRIGGER = 0.32; // scroll progress, just after "Operate as one." has settled
    let time = reduce ? T_END : 0; // current position on the timeline
    let target = time;
    let last = 0;
    let playing = false;
    const smooth = (v: number) => { const x = clamp(v); return x * x * (3 - 2 * x); };
    const win = (u: number, a: number, b: number) => smooth((u - a) / (b - a));

    const render = () => {
      const stage = root.firstElementChild as HTMLElement;
      const W = stage.clientWidth;
      const H = stage.clientHeight;
      const k = Math.min(1, W / 1440); // scale Figma sizes on narrower screens
      const total = root.offsetHeight - H;
      const p = reduce ? 1 : clamp(-root.getBoundingClientRect().top / total);

      const tText = seg(p, 0.06, 0.2); // phrase 1 → phrase 2 (scroll-driven)
      const u = hamsaEase(time / T_END); // the one eased progress (settles just past 1)
      const tRound = win(u, 0, 0.3); // corners round up to the pill radius
      const tRingTex = win(u, 0.2, 0.5); // cross-fade to Figma's ring texture
      // The hollowing and the ring's fade run on clock time, not on u (u moves fastest mid-motion, which made
      // them flash). The inside simply fades in at the ring's width; no opening from the centre.
      const t = time / T_END;
      const tHole = win(t, 0.2, 0.5); // the inside fades to the embossed background, leaving the photo ring
      const tOut = win(t, 0.65, 1); // photo ring thins and fades as the black outline arrives

      const full: Box = { ...FULL, w: W / k, h: H / k };
      // On narrow screens the scaled-down Figma pill is too small for the text, so there the pill is sized
      // around the words instead (28px of padding each side, 60px tall). In Figma units, like everything here.
      const textW = words.offsetWidth;
      const pill = { w: Math.max(PILL.w, (textW + 56) / k), h: Math.max(PILL.h, 60 / k) };
      const w = Math.max(0, lerp(full.w, pill.w, u));
      const h = Math.max(0, lerp(full.h, pill.h, u));
      const r = Math.max(PILL.r, pill.h / 2) * tRound;

      media.style.width = `${w * k}px`;
      media.style.height = `${h * k}px`;
      media.style.borderRadius = `${r * k}px`;
      media.style.opacity = String(1 - tOut);
      // Parallax: the photo shrinks less than the shape masking it (to 70% vs the box's ~40%), so the frame
      // appears to close in over the flock rather than the whole picture scaling down with it.
      const img = lerp(1, IMG_END, u);
      const cover = (ar: number, scale = 1) => { const cw = Math.max(W, H * ar); return `${cw * scale}px ${(cw / ar) * scale}px`; };
      media.style.setProperty('--flock-size', cover(FLOCK_AR, img));
      media.style.setProperty('--ring-size', cover(RING_AR, img));
      media.style.setProperty('--ring-o', String(tRingTex));
      const inset = RING.ring * k * (1 - tOut); // ring width; thins to nothing as the outline arrives
      hole.style.inset = `${inset}px`;
      hole.style.borderRadius = `${Math.max(0, r * k - inset)}px`;
      hole.style.opacity = String(tHole);
      hole.style.backgroundSize = cover(EMBOSS_AR); // same crop as the stage background, so the two line up

      const tFade = win(u, 0, 0.25);
      lines[0].style.opacity = String((1 - tText) * (1 - tFade));
      lines[1].style.opacity = String(tText * (1 - tFade));
      // As the ring forms, "Request a demo" plays in word by word (CSS transition on the class).
      // On the way back up the words leave as soon as the reverse starts, not when the shape gets there.
      const ctaIn = u >= 0.45 && (reduce || p >= TRIGGER);
      root.classList.toggle('is-cta-in', ctaIn);
      cta.style.pointerEvents = ctaIn ? 'auto' : 'none';
      // The text box stays the final pill size so the words never re-centre (that made them wobble);
      // only the outline behind them follows the shrinking shape.
      cta.style.width = `${Math.round(pill.w * k)}px`;
      cta.style.height = `${Math.round(pill.h * k)}px`;
      cta.style.setProperty('--ow', `${w * k}px`);
      cta.style.setProperty('--oh', `${h * k}px`);
      cta.style.setProperty('--oa', String(tOut));
      scrim.style.opacity = String(tOut);

      // Crossing the trigger point starts the timeline; crossing back reverses it.
      if (!reduce) {
        const next = p >= TRIGGER ? T_END : 0;
        if (next !== target) {
          target = next;
          if (!playing) { playing = true; last = performance.now(); requestAnimationFrame(tick); }
        }
      }
    };

    // Forward plays at real time; reverse is an exit, so it runs at 75% of the time (brand/motion.md).
    const tick = (now: number) => {
      const dt = now - last;
      last = now;
      time = target > time ? Math.min(target, time + dt) : Math.max(target, time - dt / 0.75);
      render();
      if (time !== target) requestAnimationFrame(tick);
      else playing = false;
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        render();
      });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    render();
  });
</script>

<style define:vars={{ flock: `url(${asset('images/flock.webp')})`, emboss: `url(${asset('images/emboss-bg.webp')})`, ring: `url(${asset('images/flock-ring.webp')})` }}>
  .flock {
    position: relative;
    height: 350vh; /* scroll distance: phrase swap, trigger, then time to take in the pill */
  }
  .flock__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .flock__stage > * { grid-area: 1 / 1; }
  .flock__bg {
    position: absolute;
    inset: 0;
    background: var(--emboss) center / cover no-repeat; /* Figma: STRETCH at 16:9; cover so phones don't distort it */
  }
  .flock__media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--flock) center / var(--flock-size, cover) no-repeat;
  }
  .flock__media::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ring) center / var(--ring-size, cover) no-repeat; /* Figma: FILL; sized in JS for the parallax */
    opacity: var(--ring-o, 0);
  }
  /* Inside of the ring: shows the embossed background through a frosted pane (Figma: fill 2% white, bg blur 25). */
  .flock__hole {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: var(--emboss) center / cover no-repeat;
    box-shadow: inset 0 0 0 100vmax rgb(255 255 255 / 0.02);
  }
  .flock__line {
    position: relative;
    margin-top: -106px; /* Figma: text sits 53px above centre */
    color: #fff;
    font-size: 80px;
    font-weight: 500;
    line-height: 68px; /* 85% */
    text-align: center;
    pointer-events: none;
  }
  .flock__line[data-line='1'] { opacity: 0; }
  .flock__cta {
    position: relative;
    display: grid;
    place-items: center;
    border-radius: 100px;
    color: #000;
    font-size: 48px;
    font-weight: 500;
    line-height: 48px;
    transition: background-color var(--dur-1) var(--ease-hamsa), color var(--dur-1) var(--ease-hamsa);
  }
  /* The outline: follows the shape during the motion, while the text box itself never changes size. */
  .flock__cta::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: -1;
    width: var(--ow, 100%);
    height: var(--oh, 100%);
    transform: translate(-50%, -50%);
    border: 2px solid rgb(0 0 0 / var(--oa, 0));
    border-radius: 100px;
    transition: background-color var(--dur-1) var(--ease-hamsa);
  }
  .flock__words { display: inline-flex; gap: 0.25em; position: relative; top: -4px; }
  .flock__word { display: inline-block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .flock__word > span {
    display: inline-block;
    transform: translateY(110%);
    transition: transform calc(var(--dur-2) * 0.75) var(--ease-hamsa-exit);
  }
  /* Words slide up into the pill one at a time (3 × --stagger apart so each word reads on its own). */
  .flock.is-cta-in .flock__word > span {
    transform: none;
    transition: transform var(--dur-2) var(--ease-hamsa) calc(var(--stagger) * 3 * var(--i));
  }
  @media (prefers-reduced-motion: reduce) {
    .flock__word > span, .flock.is-cta-in .flock__word > span { transition: none; }
  }
  /* Solid black on hover: over the photo ring, the 85% fill used by other pills would let the image show through. */
  .flock__cta:hover, .flock__cta:focus-visible { color: #fff; }
  .flock__cta:hover::before, .flock__cta:focus-visible::before { background: #000; }
  .flock__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0) 55.8%, #fff 96%); /* Figma scrim, y 452→779 of 810 */
    opacity: 0;
    pointer-events: none;
  }
  .flock__cta { z-index: 1; }

  @media (max-width: 767px) {
    .flock__line { font-size: 44px; line-height: 40px; padding: 0 16px; }
    .flock__cta { font-size: 28px; }
    .flock__words { top: -1px; } /* the desktop 4px lift is too much in the smaller pill; this centres the letters optically */
  }
</style>
