---
import { asset } from '../lib/asset';
// Figma: "Module 1" (181:2667). Five frames of one scroll-driven sequence, 1440×810 each:
//   1a  full-bleed starling murmuration, "Don't sacrifice privacy."       (181:2721)
//   1a' same image, "Operate as one."                                     (195:4460)
//   1b  image shrinks to a 1090×580 card (radius 100) on the embossed bg   (181:2692)
//   1c  card becomes a 637×176 ring (30px image stroke), "Request a demo"   (181:2680)
//   1d  ring becomes a 579×120 black 2px outline pill; scrim fades to white (181:2668)
// The section pins while you scroll. Scroll swaps the two phrases; past a set point, 1b → 1d plays as one
// timed animation (not scrubbed), and scrolling back above that point plays it in reverse.
---
<section class="flock" data-flock aria-label="Don't sacrifice privacy. Operate as one.">
  <div class="flock__stage">
    <div class="flock__bg" aria-hidden="true"></div>
    <div class="flock__media" data-media aria-hidden="true">
      <div class="flock__hole" data-hole></div>
    </div>
    <p class="flock__line" data-line="0">Don't sacrifice privacy.</p>
    <p class="flock__line" data-line="1">Operate as one.</p>
    <a class="flock__cta" href="#contact" data-cta aria-label="Request a demo"><span class="flock__words" aria-hidden="true">{['Request', 'a', 'demo'].map((w, i) => <span class="flock__word"><span style={`--i: ${i}`}>{w}</span></span>)}</span></a>
    <div class="flock__scrim" data-scrim aria-hidden="true"></div>
  </div>
</section>

<script>
  import { hamsaEase } from '../lib/motion';
  type Box = { w: number; h: number; r: number; ring: number };
  // Keyframes in Figma pixels, centred on the stage. `w: 0` means "full stage".
  const FULL: Box = { w: 0, h: 0, r: 0, ring: 0 };
  const CARD: Box = { w: 1090, h: 580.3, r: 100, ring: 0 };
  const RING: Box = { w: 637, h: 176, r: 100, ring: 30 };
  const PILL: Box = { w: 579, h: 120, r: 100, ring: 0 };

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const seg = (p: number, a: number, b: number) => hamsaEase(clamp((p - a) / (b - a)));

  document.querySelectorAll<HTMLElement>('[data-flock]').forEach((root) => {
    const media = root.querySelector<HTMLElement>('[data-media]')!;
    const hole = root.querySelector<HTMLElement>('[data-hole]')!;
    const lines = root.querySelectorAll<HTMLElement>('[data-line]');
    const cta = root.querySelector<HTMLElement>('[data-cta]')!;
    const scrim = root.querySelector<HTMLElement>('[data-scrim]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // The 1b → 1d transition as a timeline in ms, built from the motion durations (--dur-1…3).
    const T_CARD = [0, 800], T_RING = [800, 1200], T_HOLE = [1200, 1400], T_PILL = [1600, 2400];
    const T_CTA = 1400; // "Request a demo" words start once the ring is complete
    const T_END = T_PILL[1];
    const TRIGGER = 0.32; // scroll progress, just after "Operate as one." has settled
    let time = reduce ? T_END : 0; // current position on the timeline
    let target = time;
    let last = 0;
    let playing = false;
    const at = (t: number, [a, b]: number[]) => hamsaEase(clamp((t - a) / (b - a)));

    const render = () => {
      const stage = root.firstElementChild as HTMLElement;
      const W = stage.clientWidth;
      const H = stage.clientHeight;
      const k = Math.min(1, W / 1440); // scale Figma sizes on narrower screens
      const total = root.offsetHeight - H;
      const p = reduce ? 1 : clamp(-root.getBoundingClientRect().top / total);

      const tText = seg(p, 0.06, 0.2); // phrase 1 → phrase 2 (scroll-driven)
      const tCard = at(time, T_CARD); // full bleed → card
      const tRing = at(time, T_RING); // card shrinks, still solid, into the pill shape
      const tHole = at(time, T_HOLE); // the centre opens from the middle out, leaving the photo ring
      const tPill = at(time, T_PILL); // ring → outline pill

      const full: Box = { ...FULL, w: W / k, h: H / k };
      let b: Box;
      if (tRing === 0) b = mix(full, CARD, tCard);
      else if (tPill === 0) b = mix(CARD, RING, tRing);
      else b = mix(RING, PILL, tPill);
      // (b.ring is ignored below: the hole's own phase draws the ring.)

      media.style.width = `${b.w * k}px`;
      media.style.height = `${b.h * k}px`;
      media.style.borderRadius = `${b.r * k}px`;
      media.style.opacity = String(1 - tPill);
      media.style.setProperty('--ring-o', String(tRing)); // Figma uses a separate texture for the ring
      // The hole grows from a sliver in the middle to the final 30px ring, so the photo never turns see-through.
      const ringInset = RING.ring * k * (tPill > 0 ? 1 - tPill : 1);
      const collapsed = (Math.min(b.w, b.h) * k) / 2;
      const inset = tPill > 0 ? ringInset : collapsed + (ringInset - collapsed) * tHole;
      hole.style.inset = `${inset}px`;
      hole.style.borderRadius = `${Math.max(0, b.r * k - inset)}px`;
      hole.style.opacity = tHole > 0 ? '1' : '0';
      hole.style.backgroundSize = `${W}px ${H}px`; // line up with the stage background

      lines[0].style.opacity = String((1 - tText) * (1 - tCard));
      lines[1].style.opacity = String(tText * (1 - tCard));
      // Once the ring is complete, "Request a demo" plays in word by word (CSS transition on the class).
      const ctaIn = time >= T_CTA;
      root.classList.toggle('is-cta-in', ctaIn);
      cta.style.pointerEvents = ctaIn ? 'auto' : 'none';
      cta.style.width = `${b.w * k}px`;
      cta.style.height = `${b.h * k}px`;
      cta.style.borderColor = `rgb(0 0 0 / ${tPill})`;
      scrim.style.opacity = String(tPill);

      // Crossing the trigger point starts the timeline; crossing back reverses it.
      if (!reduce) {
        const next = p >= TRIGGER ? T_END : 0;
        if (next !== target) {
          target = next;
          if (!playing) { playing = true; last = performance.now(); requestAnimationFrame(tick); }
        }
      }
    };

    // Forward plays at real time; reverse is an exit, so it runs at 75% of the time (brand/motion.md).
    const tick = (now: number) => {
      const dt = now - last;
      last = now;
      time = target > time ? Math.min(target, time + dt) : Math.max(target, time - dt / 0.75);
      render();
      if (time !== target) requestAnimationFrame(tick);
      else playing = false;
    };

    const mix = (a: Box, b: Box, t: number): Box => ({
      w: lerp(a.w, b.w, t),
      h: lerp(a.h, b.h, t),
      r: lerp(a.r, b.r, t),
      ring: lerp(a.ring, b.ring, t),
    });

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        render();
      });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    render();
  });
</script>

<style define:vars={{ flock: `url(${asset('images/flock.webp')})`, emboss: `url(${asset('images/emboss-bg.webp')})`, ring: `url(${asset('images/flock-ring.webp')})` }}>
  .flock {
    position: relative;
    height: 350vh; /* scroll distance: phrase swap, trigger, then time to take in the pill */
  }
  .flock__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .flock__stage > * { grid-area: 1 / 1; }
  .flock__bg {
    position: absolute;
    inset: 0;
    background: var(--emboss) center / 100% 100% no-repeat; /* Figma: STRETCH */
  }
  .flock__media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--flock) center / cover no-repeat;
  }
  .flock__media::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ring) center / cover no-repeat; /* Figma: FILL */
    opacity: var(--ring-o, 0);
  }
  /* Inside of the ring: shows the embossed background through a frosted pane (Figma: fill 2% white, bg blur 25). */
  .flock__hole {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: var(--emboss) center / 100% 100% no-repeat;
    box-shadow: inset 0 0 0 100vmax rgb(255 255 255 / 0.02);
  }
  .flock__line {
    position: relative;
    margin-top: -106px; /* Figma: text sits 53px above centre */
    color: #fff;
    font-size: 80px;
    font-weight: 500;
    line-height: 68px; /* 85% */
    text-align: center;
    pointer-events: none;
  }
  .flock__line[data-line='1'] { opacity: 0; }
  .flock__cta {
    position: relative;
    display: grid;
    place-items: center;
    border: 2px solid transparent;
    border-radius: 100px;
    color: #000;
    font-size: 48px;
    font-weight: 500;
    line-height: 48px;
    transition: background-color var(--dur-1) var(--ease-hamsa), color var(--dur-1) var(--ease-hamsa);
  }
  .flock__words { display: inline-flex; gap: 0.25em; }
  .flock__word { display: inline-block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .flock__word > span {
    display: inline-block;
    transform: translateY(110%);
    transition: transform calc(var(--dur-2) * 0.75) var(--ease-hamsa-exit);
  }
  /* Words slide up into the pill one at a time (3 × --stagger apart so each word reads on its own). */
  .flock.is-cta-in .flock__word > span {
    transform: none;
    transition: transform var(--dur-2) var(--ease-hamsa) calc(var(--stagger) * 3 * var(--i));
  }
  @media (prefers-reduced-motion: reduce) {
    .flock__word > span, .flock.is-cta-in .flock__word > span { transition: none; }
  }
  /* Solid black on hover: over the photo ring, the 85% fill used by other pills would let the image show through. */
  .flock__cta:hover, .flock__cta:focus-visible { background: #000; color: #fff; }
  .flock__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0) 55.8%, #fff 96%); /* Figma scrim, y 452→779 of 810 */
    opacity: 0;
    pointer-events: none;
  }
  .flock__cta { z-index: 1; }

  @media (max-width: 767px) {
    .flock__line { font-size: 44px; line-height: 40px; padding: 0 16px; }
    .flock__cta { font-size: 28px; }
  }
</style>
