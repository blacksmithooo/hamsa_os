---
// Figma: "Module 2a" (181:2605) and "Module 2b" (181:2543), one 1440×671 section in two states:
//   2a — "Tokenized Deposits" at half size (blur 4) and "Cash" at quarter size (blur 10), still arriving
//   2b — all ten circles at full size, forming the cluster
// Built as a reveal: all circles gather into place when the section scrolls into view, the two above last.
// Each circle's gradient is converted exactly from its Figma handles (they are offset per circle).
const circles = [
  { label: 'Mutual<br />Funds', x: 923, y: 84, bg: 'linear-gradient(55.1deg, #3b3b61 -187.1px, #d2506a 63.4px, #ffc34a 313.9px)' },
  { label: 'Money Market<br />Funds', x: 772, y: 172, bg: 'linear-gradient(55.1deg, #3b3b61 -22.6px, #d2506a 227.5px, #ffc34a 477.6px)' },
  { label: 'Equities', x: 1074, y: 172, bg: 'linear-gradient(55.1deg, #3b3b61 -306.9px, #d2506a -58.9px, #ffc34a 189.2px)' },
  { label: 'Fixed<br />Income', x: 621, y: 261, bg: 'linear-gradient(55.1deg, #3b3b61 99.8px, #d2506a 349.1px, #ffc34a 598.3px)' },
  { label: 'Alternatives', x: 923, y: 261, bg: 'linear-gradient(55.1deg, #3b3b61 -143.8px, #d2506a 105.9px, #ffc34a 355.5px)' },
  { label: 'Cash', x: 1225, y: 261, bg: 'linear-gradient(55.1deg, #3b3b61 -397.3px, #d2506a -146px, #ffc34a 105.3px)', arrive: 'far' },
  { label: 'Tokenized<br />Assets', x: 772, y: 349, bg: 'linear-gradient(55.1deg, #3b3b61 31.1px, #d2506a 278.7px, #ffc34a 526.3px)' },
  { label: 'Tokenized<br />Deposits', x: 1074, y: 349, bg: 'linear-gradient(55.1deg, #3b3b61 -220.1px, #d2506a 31.6px, #ffc34a 283.3px)', arrive: 'near' },
  { label: 'Stablecoins', x: 923, y: 437, bg: 'linear-gradient(55.1deg, #3b3b61 -186.3px, #d2506a 66.3px, #ffc34a 318.8px)' },
];
// Arrival order: the centre circle first, then outwards by distance; the two Figma "arriving" circles come last.
const cx = 923, cy = 261;
const order = [...circles]
  .sort((a, b) => (a.arrive ? 1 : 0) - (b.arrive ? 1 : 0) || Math.hypot(a.x - cx, a.y - cy) - Math.hypot(b.x - cx, b.y - cy));
---
<section class="assets" data-reveal>
  <div class="assets__copy">
    <p class="eyebrow">Why Hamsa</p>
    <h2 class="assets__title">Operate as one. Across your assets and partners.</h2>
    <div class="assets__body body-20">
      <p>Bring your traditional, tokenized and digital assets together on a Unified Ledger, without giving up control of your data.</p>
      <p>Keep sensitive data private. Share only what’s needed. Coordinate ownership, identity and settlement across your partners in real time.</p>
    </div>
  </div>

  <ul class="assets__cluster" aria-label="Asset classes on the Unified Ledger">
    {circles.map((c) => (
      <li class:list={['circle', c.arrive && `circle--${c.arrive}`]} style={`left:${c.x}px; top:${c.y}px; background:${c.bg}; --i:${order.indexOf(c)}`}>
        <span set:html={c.label} />
      </li>
    ))}
  </ul>
</section>

<script>
  import { observeReveal } from '../lib/reveal';
  observeReveal();

  // Scale the cluster to the available width on narrow screens (see the 1100px media query).
  document.querySelectorAll<HTMLElement>('.assets__cluster').forEach((cluster) => {
    const fit = () => cluster.style.setProperty('--k', String(Math.min(1, (cluster.parentElement!.clientWidth - 48) / 755)));
    new ResizeObserver(fit).observe(cluster.parentElement!);
  });
</script>

<style>
  .assets {
    position: relative;
    max-width: var(--frame);
    height: 671px;
    margin: 0 auto;
  }
  /* Copy block: x=60, y=107, padding 40/40/35/40, gap −12 */
  .assets__copy {
    position: absolute;
    left: 100px;
    top: 147px;
    width: 452px;
  }
  .assets__title {
    margin-top: 23.7px;
    font-size: 48px;
    font-weight: 500;
    line-height: 45.6px; /* 95% */
  }
  .assets__body { margin-top: 17px; }
  .assets__body p + p { margin-top: 10px; } /* Figma paragraph spacing */

  .assets__cluster { position: absolute; inset: 0; }
  .circle {
    position: absolute;
    width: 151px;
    height: 151px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    font-size: 20.59px;
    font-weight: 500;
    line-height: 20.59px;
    text-align: center;
  }
  /* State 2a: the two arriving circles, before the section is revealed. */
  /* Before the reveal every circle is small, blurred and hidden; they gather one after another from the centre
     outwards (--i), the two Figma "arriving" circles last. */
  .assets.is-armed:not(.is-revealed) .circle { transform: scale(0.3); filter: blur(8px); opacity: 0; }
  .assets.is-revealed .circle {
    transition: transform var(--dur-4) var(--ease-hamsa), filter var(--dur-3) var(--ease-hamsa), opacity var(--dur-3) var(--ease-hamsa);
    transition-delay: calc(var(--stagger) * 3 * var(--i));
  }

  @media (prefers-reduced-motion: reduce) {
    .circle, .assets.is-revealed .circle { transition: none; }
  }

  /* Narrower screens: the cluster's own box (x 621–1376, y 84–588 in Figma, 755×504) is centred under the
     copy and scaled to fit the width (--k, set by the script). */
  @media (max-width: 1100px) {
    .assets { height: auto; padding: 64px 24px; overflow-x: clip; }
    .assets__copy { position: static; width: auto; max-width: 560px; }
    .assets__cluster {
      position: relative;
      inset: auto;
      width: 755px;
      height: calc(504px * var(--k, 1));
      margin: 40px 0 0 calc(50% - 377.5px);
      transform: scale(var(--k, 1));
      transform-origin: 50% 0;
    }
    .circle { translate: -621px -84px; }
    .assets__title { font-size: 36px; line-height: 36px; }
  }
</style>
