---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import FlockSequence from '../components/FlockSequence.astro';
import AssetCluster from '../components/AssetCluster.astro';
import UnifiedStack from '../components/UnifiedStack.astro';
import Applications from '../components/Applications.astro';
import InstitutionalScale from '../components/InstitutionalScale.astro';
import Team from '../components/Team.astro';
import Clients from '../components/Clients.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<Base>
  <SiteHeader />
  <main class="page">
    <Hero />
    <FlockSequence />
    <AssetCluster />
    <UnifiedStack />
    <Applications />
    <InstitutionalScale />
    <Team />
    <Clients />
  </main>
  <SiteFooter />
</Base>

<style>
  /* Vertical gaps between sections, measured between consecutive frames in Figma (page R3). */
  .page > :global(.assets) { margin-top: 42px; }
  .page > :global(.stack) { margin-top: 233px; }
  .page > :global(.apps) { margin-top: 189px; }
  .page > :global(.stats) { margin-top: 54px; }
  .page > :global(.team) { margin-top: 111px; }
  .page > :global(.clients) { margin-top: 187px; }
  :global(.footer) { margin-top: 206px; }

  @media (max-width: 1100px) {
    .page > :global(*) { margin-top: 64px; }
    .page > :global(.hero), .page > :global(.flock) { margin-top: 0; }
    :global(.footer) { margin-top: 64px; }
  }
</style>
